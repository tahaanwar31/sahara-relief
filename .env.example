# Copy to .env and fill in. NEVER commit .env.

# "local" = users table + our own signed token (default for development and the demo fallback)
# "supabase" = sign in through Supabase Auth
AUTH_MODE=local

# Postgres connection string.
# Local (no Docker): run `node scripts/local_pg.mjs` first, then use:
#   postgresql://postgres:postgres@127.0.0.1:5433/postgres
# Supabase: the "connection string" from Project Settings > Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Used to sign tokens in local mode (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Supabase (cloud). SERVICE KEY is the master key: server only, never in the web app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

STORAGE_MODE=local
LLM_PROVIDER=none
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=120
